# WordPress GraphQL endpoint
NEXT_PUBLIC_WORDPRESS_API_URL=https://www.mychicmirror.com/graphql

# Indirizzo di WordPress per checkout e area clienti (dopo la migrazione: https://cms.mychicmirror.com)
NEXT_PUBLIC_WORDPRESS_SITE_URL=https://www.mychicmirror.com

# Indicizzazione dei motori di ricerca: "true" solo in produzione sul dominio vero (go-live).
# Altrimenti robots.txt blocca tutto e ogni risposta ha X-Robots-Tag: noindex
NEXT_PUBLIC_ALLOW_INDEXING=

# URL pubblico del sito (link di condivisione, canonical)
NEXT_PUBLIC_SITE_URL=https://www.mychicmirror.com

# Google Analytics 4 (es. G-XXXXXXXXXX); se vuota GA non viene caricato
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Chiave pubblica reCAPTCHA v3 usata da Contact Form 7 (form contatti)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LcTiG4aAAAAADncVzow5X3S9iqmgtfO5Q7qLT01

# Endpoint PHP custom sul server WordPress (JSON)
BOOKS_EDITED_DATA=https://www.mychicmirror.com/API/getBooks.php
BOOKS_REVIEWS_DATA=https://www.mychicmirror.com/API/getBookReviews.php

# Foto di copertina della home
MAIN_IMAGE_COVER_URL=https://www.mychicmirror.com/wp-content/uploads/cs_bg_optimized.png

# Revalidazione on-demand: segreto condiviso con WordPress (MCM_REVALIDATE_SECRET in wp-config.php)
REVALIDATE_SECRET=

# Anteprime dall'editor: segreto condiviso con WordPress (MCM_PREVIEW_SECRET in wp-config.php)
PREVIEW_SECRET=
# Utente WordPress e sua Application Password (Utenti > Profilo) per leggere le bozze
WP_PREVIEW_USER=
WP_PREVIEW_APP_PASSWORD=

# MySQL (solo per il tool admin /admin/reviews-upload)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Password richiesta dal tool admin /admin/reviews-upload
ADMIN_UPLOAD_PASSWORD=
